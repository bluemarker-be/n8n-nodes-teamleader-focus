{
	"name": "@bluemarker/n8n-nodes-teamleader-focus",
	"version": "0.2.4",
	"description": "n8n community node for Teamleader Focus",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"teamleader",
		"teamleader-focus",
		"crm",
		"invoicing"
	],
	"license": "MIT",
	"homepage": "https://github.com/bluemarker-be/n8n-nodes-teamleader-focus",
	"author": {
		"name": "Henk de Blauw",
		"email": "henk@bluemarker.be",
		"url": "https://www.bluemarker.be"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bluemarker-be/n8n-nodes-teamleader-focus.git"
	},
	"main": "index.js",
	"scripts": {
		"build": "n8n-node build",
		"dev": "n8n-node dev",
		"format": "prettier --write \"**/*.ts\"",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TeamleaderFocusOAuth2Api.credentials.js"
		],
		"nodes": [
			"dist/nodes/TeamleaderFocus/TeamleaderFocus.node.js",
			"dist/nodes/TeamleaderFocus/TeamleaderFocusTrigger.node.js"
		]
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.1.0",
		"@types/node": "^25.3.3",
		"eslint": "^9.0.0",
		"n8n-workflow": "*",
		"prettier": "^3.2.0",
		"typescript": "~5.4.0"
	}
}
